{
  "name": "brelly",
  "version": "1.0.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "29.5.14",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "firebase": "^12.17.1",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "**/@expo/plist/@xmldom/xmldom": "0.8.15",
    "**/xcode/uuid": "11.1.1",
    "**/@bacons/xcode/uuid": "11.1.1"
  },
  "scripts": {
    "typecheck": "yarn typecheck:mobile",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile",
    "lint": "eslint . --max-warnings 0",
    "test": "yarn workspace @brelly/mobile test && yarn test:core",
    "test:coverage": "yarn workspace @brelly/mobile test:coverage && yarn workspace @brelly/core test:coverage",
    "test:core": "yarn workspace @brelly/core test",
    "test:emulator": "firebase emulators:exec --project demo-brelly --only firestore \"jest --config jest.emulator.config.js\"",
    "prepare": "git config core.hooksPath .githooks",
    "verify:fast": "yarn typecheck && yarn lint && yarn test",
    "verify": "yarn typecheck && yarn lint && yarn test:coverage"
  }
}
