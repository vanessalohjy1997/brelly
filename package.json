{
  "name": "brelly",
  "version": "1.0.2",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "29.5.14",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "firebase": "^12.17.1",
    "jest": "^29.7.0",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "**/@expo/plist/@xmldom/xmldom": "0.8.15",
    "**/xcode/uuid": "11.1.1",
    "**/@bacons/xcode/uuid": "11.1.1"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "yarn typecheck:mobile && yarn typecheck:web",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile",
    "typecheck:web": "tsc --noEmit -p apps/web",
    "lint": "eslint . --max-warnings 0",
    "test": "yarn workspace @brelly/mobile test && yarn test:core && yarn test:web",
    "test:coverage": "yarn workspace @brelly/mobile test:coverage && yarn workspace @brelly/core test:coverage && yarn workspace @brelly/web test:coverage",
    "test:core": "yarn workspace @brelly/core test",
    "test:web": "yarn workspace @brelly/web test",
    "dev:web": "yarn workspace @brelly/web dev",
    "test:emulator": "firebase emulators:exec --project demo-brelly --only firestore \"jest --config jest.emulator.config.js\"",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "verify:fast": "yarn typecheck && yarn lint && yarn test",
    "verify": "yarn typecheck && yarn lint && yarn test:coverage",
    "deploy:rules": "firebase deploy --only firestore"
  }
}
