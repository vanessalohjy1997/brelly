{
  "expo": {
    "name": "brelly",
    "slug": "brelly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/light-hook.png",
    "scheme": "brelly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon/light-hook.png",
        "dark": "./assets/icon/dusk-hook.png",
        "tinted": "./assets/icon/tinted-hook.png"
      },
      "bundleIdentifier": "com.brelly.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ECE6F8",
        "foregroundImage": "./assets/icon/android-foreground.png",
        "backgroundImage": "./assets/icon/android-background.png",
        "monochromeImage": "./assets/icon/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brelly.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6FB",
          "image": "./assets/icon/splash-hook.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#120F1A",
            "image": "./assets/icon/splash-hook-dark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brelly uses your location to prefill the location field when adding a plan and to show the weather nearby when you have no plans."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Brelly reads your calendar so you can turn events into plans, and writes to it so your plans show up alongside everything else."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/notification-icon.png",
          "color": "#5B44C4"
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
