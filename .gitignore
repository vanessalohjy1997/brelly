# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
firebase-debug.log
firestore-debug.log

# macOS
.DS_Store
*.pem

# local env files
.env

# firebase project config (real project identifiers, per-developer/per-project)
GoogleService-Info.plist
google-services.json

# typescript
*.tsbuildinfo

example

# generated native folders. Anchored, and that is load-bearing beyond tidiness:
# @expo/fingerprint's ProjectWorkflow flips managed -> generic when `ios/` is
# not ignored, and then hashes the whole generated tree, Pods/ and build/
# included — so local and CI compute different runtime versions. It shells
# `git check-ignore` from the VCS root, which is why a rule here works exactly
# as well as one in apps/mobile/.gitignore would.
/apps/mobile/ios
/apps/mobile/android

# @bacons/apple-targets regenerates these into the widget target dir on every
# prebuild (from expo-target.config.js) — build artifacts like /ios, not source.
# The source that IS tracked: expo-target.config.js and index.swift.
/apps/mobile/targets/*/Info.plist
/apps/mobile/targets/*/Assets.xcassets/

# test coverage. Unanchored on purpose: two workspaces write one of these now.
coverage/

# Next.js (apps/web, from phase 3)
.next/
out/
