# Firebase web config. Public by design — these identify the project, they do
# not authorise anything; `firestore.rules` is what does that.
#
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN is the one to be careful with. It must be
# the same origin the app is served from, because `signInWithPopup` bounces
# through `https://<authDomain>/__/auth/handler` and Safari's storage
# partitioning breaks that hop when it is cross-site. Firebase Hosting serves
# `/__/**` from the `*.web.app` site itself, so deploying behind the Hosting
# rewrite and setting this to that site is what makes the two match.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=brelly-50de6.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brelly-50de6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Places and Geocoding key, read only by `/api/places`. No `NEXT_PUBLIC_`
# prefix, deliberately: that prefix is what makes Next inline a value into the
# browser bundle, which would defeat the proxy entirely. CI greps for a
# `NEXT_PUBLIC_*PLACES*` to keep it that way.
#
# One key covers both SKUs — Places (autocomplete, details) and Geocoding
# (reverse) — so there is one value here rather than two.
GOOGLE_PLACES_KEY=
